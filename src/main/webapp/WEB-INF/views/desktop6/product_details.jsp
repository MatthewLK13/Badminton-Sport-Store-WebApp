<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %>
<%@ taglib uri="http://java.sun.com/jsp/jstl/fmt" prefix="fmt" %>
<%@ taglib uri="http://java.sun.com/jsp/jstl/functions" prefix="fn" %>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>${product.productName}</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap">
<link rel="stylesheet" href="${pageContext.request.contextPath}/css/product_details.css">
<link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css">
</head>
<body>
<%@include file="/WEB-INF/views/includes/header.jsp" %>
<%-- BREADCRUMB --%>
<div class="breadcrumb-container">
    <div class="breadcrumb-content">
        <a href="${pageContext.request.contextPath}/home.htm">Trang chủ</a>
        <span class="breadcrumb-separator">></span>
        <a href="${pageContext.request.contextPath}/products/index.htm?id=${product.category_id.id}">
            ${product.category_id.categoryName}
        </a>
        <span class="breadcrumb-separator">></span>
        <span class="active">${product.productName}</span>
    </div>
</div>

<%-- MAIN DETAIL --%>
<div class="detail-container">

    <%-- CỘT TRÁI: ẢNH GRID 2x2 --%>
    <div class="detail-images">
        <c:forEach var="img" items="${product.productImages}">
            <a href="?id=${product.id}&img=${img.imageUrl}">
                <div class="grid-img-wrapper">
                    <img src="${pageContext.request.contextPath}/images/products/${img.imageUrl}"
                         alt="${product.productName}" class="grid-img">
                </div>
            </a>
        </c:forEach>
    </div>

    <%-- CỘT PHẢI: THÔNG TIN --%>
    <div class="detail-info">

        <div class="info-top-meta">
            <span class="product-category">
                ${product.brand_id.brandName} - ${product.category_id.categoryName}
            </span>
            <span class="badge-new">Mới</span>
        </div>

        <h1 class="detail-name">${product.productName}</h1>

        <p class="detail-price">
            <fmt:formatNumber value="${product.price}" type="currency" currencySymbol="$"/>
        </p>

        <%-- MÀU SẮC --%>
        <div class="detail-section">
            <p class="section-label">Màu sắc</p>
            <div class="color-list">
                <span class="color-swatch active" style="background:#E0E0E0;"></span>
                
            </div>
        </div>

        <%-- THUỘC TÍNH BIẾN THỂ --%>
<div class="detail-section">
    <p class="section-label">
        <c:choose>
            <c:when test="${product.category_id.id == 1}">Trọng lượng</c:when>
            <c:when test="${product.category_id.id == 2}">Kích cỡ</c:when>
            <c:when test="${product.category_id.id == 3}">Kích cỡ</c:when>
            <c:when test="${product.category_id.id == 4}">Dung tích</c:when>
            <c:when test="${product.category_id.id == 5}">Tùy chọn</c:when>
            <c:otherwise>Tùy chọn</c:otherwise>
        </c:choose>
    </p>

    <div class="size-picker-grid">
        <c:forEach var="variant" items="${product.productVariants}">
            <label class="size-box ${variant.stock_quantity == 0 ? 'out-of-stock' : ''}">
                <input type="radio" name="variantId" value="${variant.id}" data-stock="${variant.stock_quantity}" ${variant.stock_quantity == 0 ? 'disabled' : ''} required>
                ${variant.variant_name}
            </label>
        </c:forEach>
    </div>

    <p id="stock-info" style="margin: 8px 0; font-size: 14px; color: #27ae60;">Vui lòng chọn biến thể để xem số lượng tồn kho.</p>

    <p class="size-hint">
        <c:choose>
            <c:when test="${product.category_id.id == 1}"><u>Chú ý khi chọn trọng lượng vợt</u></c:when>
            <c:when test="${product.category_id.id == 2}"><u>Chú ý khi chọn kích cỡ</u></c:when>
            <c:when test="${product.category_id.id == 3}"><u>Chú ý khi chọn kích cỡ</u></c:when>
            <c:when test="${product.category_id.id == 4}"><u>Chú ý khi chọn tùy chọn</u></c:when>
            <c:when test="${product.category_id.id == 5}"><u>Chú ý khi chọn tùy chọn</u></c:when>
            <c:otherwise><u>Chú ý khi chọn tùy chọn</u></c:otherwise>
        </c:choose>
    </p>
</div>
		
        <%-- HỘP GHI CHÚ --%>
        <div class="size-note-box">
            <p>Dùng kích cỡ thường. Chúng tôi khuyên bạn nên đặt theo trình độ/size phù hợp với bản thân.</p>
        </div>
		<div class="detail-section">
    <p class="section-label">Số lượng</p>
    <div class="quantity-control">
        <input type="number" name="quantity" value="1" min="1" class="quantity-input">
    </div>
</div>
        <%-- NÚT HÀNH ĐỘNG --%>
        <div class="actions-wrapper">
            <form action="${pageContext.request.contextPath}/cart/add.htm" method="post" style="display:inline;">
                <button type="submit" class="btn-add-to-cart">
                    Thêm vào giỏ hàng
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
                    </svg>
                </button>
            </form>
            <form action="${pageContext.request.contextPath}/wishlist/toggle.htm" method="post" style="display:inline;">
                <input type="hidden" name="productId" value="${product.id}">
                <button type="submit" class="btn-wishlist wishlist-btn">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path class="heart-path" fill-rule="evenodd" clip-rule="evenodd"
                              d="M19.6431 7.05858C19.6103 4.79858 18.3289 2.57286 16.3617 1.65572C15.3044 1.16162 14.0982 1.09057 12.9903 1.45715C11.9831 1.77715 10.9731 2.43286 10.0003 3.46429C9.02742 2.43286 8.01742 1.77858 7.01028 1.45715C5.90232 1.09057 4.69612 1.16162 3.63885 1.65572C1.67171 2.57286 0.390279 4.79858 0.357422 7.05858V7.07001C0.357422 10.3657 2.31742 13.2857 4.39456 15.3357C5.33754 16.2725 6.38375 17.0992 7.51314 17.8C7.99599 18.0943 8.45171 18.33 8.85599 18.4957C9.24171 18.6529 9.64599 18.7729 10.0003 18.7729C10.3546 18.7729 10.7574 18.6529 11.1431 18.4957C11.5489 18.3314 12.0046 18.0957 12.486 17.8014C13.6159 17.1002 14.6626 16.273 15.606 15.3357C17.6831 13.2857 19.6431 10.3657 19.6431 7.07144V7.05858Z"
                              fill="transparent" stroke="black" stroke-width="1.2"/>
                    </svg>
                </button>
            </form>
        </div>
    </div>
</div>
 <%-- KIỂU BÀN CHÂN --%>
 <div class = "hihi">
 	<c:if test="${product.category_id.id == 2}">
        <div class="foot-type-section">
            <div class="foot-type-item">
                <span class="foot-icon"><svg width="105" height="100" viewBox="0 0 105 100" fill="none" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
<rect width="105" height="100" fill="url(#pattern0_42_846)"/>
<defs>
<pattern id="pattern0_42_846" patternContentUnits="objectBoundingBox" width="1" height="1">
<use xlink:href="#image0_42_846" transform="matrix(0.00195561 0 0 0.00205339 -0.000635573 0)"/>
</pattern>
<image id="image0_42_846" width="512" height="487" preserveAspectRatio="none" xlink:href="data:image/png;base64,"/>
</defs>
</svg>
                </span>
                <div>
                    <p class="foot-label">TỐT NHẤT CHO</p>
                    <p class="foot-value">Chạy trong sân cầu lông</p>
                </div>
            </div>
            <div class="foot-type-item">
                <svg width="99" height="94" viewBox="0 0 99 94" fill="none" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
<rect width="99" height="94" transform="matrix(-1 0 0 1 99 0)" fill="url(#pattern0_42_849)"/>
<defs>
<pattern id="pattern0_42_849" patternContentUnits="objectBoundingBox" width="1" height="1">
<use xlink:href="#image0_42_849" transform="matrix(0.00195312 0 0 0.00205701 0 -0.000883062)"/>
</pattern>
<image id="image0_42_849" width="512" height="487" preserveAspectRatio="none" xlink:href="data:image/png;base64,"/>
</defs>
</svg>

                <div>
                    <p class="foot-label">KIỂU BÀN CHÂN</p>
                    <p class="foot-value">
                        <c:forEach var="attr" items="${productAttrs}">
                            <c:if test="${attr.attrKey == 'foot_type'}">${attr.attrValue}</c:if>
                        </c:forEach>
                        <c:if test="${empty productAttrs}">Bình thường</c:if>
                    </p>
                </div>
            </div>
        </div>
	</c:if>
	
        <%-- ACCORDION --%>
        <div class="accordion">
            <details class="accordion-item">
                <summary class="accordion-btn">
                    Đánh giá <span class="accordion-icon">▼</span>
                </summary>
                <div class="accordion-body">
                    <p>Chưa có đánh giá nào.</p>
                </div>
            </details>
            <details class="accordion-item">
                <summary class="accordion-btn">
                    Kích cỡ và độ vừa vặn <span class="accordion-icon">▼</span>
                </summary>
                <div class="accordion-body">
                    <p>Vui lòng chọn đúng kích cỡ của bạn.</p>
                </div>
            </details>
            <details class="accordion-item">
                <summary class="accordion-btn">
                    Mô tả <span class="accordion-icon">▼</span>
                </summary>
                <div class="accordion-body">
                    <p>${product.description}</p>
                </div>
            </details>
            <details class="accordion-item">
                <summary class="accordion-btn">
                    Thông tin chi tiết <span class="accordion-icon">▼</span>
                </summary>
                <div class="accordion-body">
                    <c:forEach var="attr" items="${productAttrs}">
                        <c:if test="${attr.attrKey != 'brand_filter'}">
                            <p style="margin:4px 0; font-size:14px;">
                                <span style="color:#888;">
                                    <c:choose>
                                        <%-- Vợt --%>
                            <c:when test="${attr.attrKey == 'flexibility'}">Độ cứng đũa</c:when>
                            <c:when test="${attr.attrKey == 'swingweight'}">Swingweight</c:when>
                            <c:when test="${attr.attrKey == 'balance_point'}">Điểm cân bằng</c:when>
                            <c:when test="${attr.attrKey == 'play_style'}">Phong cách chơi</c:when>
                            <c:when test="${attr.attrKey == 'play_level'}">Trình độ chơi</c:when>
                            <%-- Giày --%>
                            <c:when test="${attr.attrKey == 'foot_type'}">Kiểu bàn chân</c:when>
                            <c:when test="${attr.attrKey == 'segment_filter'}">Phân khúc</c:when>
                            <%-- Quần áo --%>
                            <c:when test="${attr.attrKey == 'clothe_type'}">Loại trang phục</c:when>
                            <%-- Túi --%>
                            <c:when test="${attr.attrKey == 'suitable_for'}">Phù hợp cho</c:when>
                            <c:when test="${attr.attrKey == 'bag_type'}">Thể loại túi</c:when>
                            <c:when test="${attr.attrKey == 'num_of_compartments'}">Số ngăn lớn</c:when>
                            <%-- Phụ kiện --%>
                            <c:when test="${attr.attrKey == 'accessory_type'}">Loại phụ kiện</c:when>
                            <c:otherwise>${attr.attrKey}</c:otherwise>
                                    </c:choose>:
                                </span>
                                <strong>${attr.attrValue}</strong>
                            </p>
                        </c:if>
                    </c:forEach>
                </div>
            </details>
            </div>

            <%-- REVIEWS SECTION --%>
            <div class="reviews-section">
                <h3 class="reviews-title">Đánh giá sản phẩm</h3>

                <%-- Average Rating Display --%>
                <div class="rating-summary">
                    <div class="rating-average">
                        <span class="big-rating"><fmt:formatNumber value="${avgRating > 0 ? avgRating : 0}" pattern="#.#"/></span>
                        <div class="stars">
                            <c:forEach var="i" begin="1" end="5">
                                <span class="star ${i <= avgRating ? 'filled' : ''}">★</span>
                            </c:forEach>
                        </div>
                        <span class="rating-count">(${reviewCount} đánh giá)</span>
                    </div>
                </div>

                <%-- Review List --%>
                <div class="reviews-list">
                    <c:forEach var="review" items="${reviews}">
                        <div class="review-item">
                            <div class="review-header">
                                <span class="review-author">${review.user.fullName}</span>
                                <span class="review-date"><fmt:formatDate value="${review.createdAt}" pattern="dd/MM/yyyy"/></span>
                            </div>
                            <div class="review-stars">
                                <c:forEach var="i" begin="1" end="5">
                                    <span class="star ${i <= review.rating ? 'filled' : ''}">★</span>
                                </c:forEach>
                            </div>
                            <p class="review-comment">${review.comment}</p>
                        </div>
                    </c:forEach>
                    <c:if test="${empty reviews}">
                        <p class="no-reviews">Chưa có đánh giá nào. Hãy là người đầu tiên đánh giá!</p>
                    </c:if>
                </div>

                <%-- Add Review Form --%>
                <c:if test="${not empty sessionScope.user}">
                    <c:if test="${!hasReviewed}">
                        <div class="add-review-form">
                            <h4>Thêm đánh giá của bạn</h4>
                            <form action="${pageContext.request.contextPath}/review/add.htm" method="post">
                                <input type="hidden" name="productId" value="${product.id}">
                                <div class="rating-input">
                                    <label>Rating:</label>
                                    <div class="star-selector">
                                        <c:forEach var="i" begin="1" end="5">
                                            <input type="radio" name="rating" value="${i}" id="rating${i}" required>
                                            <label for="rating${i}" class="star-label">★</label>
                                        </c:forEach>
                                    </div>
                                </div>
                                <div class="comment-input">
                                    <textarea name="comment" placeholder="Nhận xét của bạn..." rows="3" required></textarea>
                                </div>
                                <button type="submit" class="btn-submit-review">Gửi đánh giá</button>
                            </form>
                        </div>
                    </c:if>
                </c:if>
            </div>
        </div>
</div>

<%-- HOÀN THIỆN PHONG CÁCH --%>
<div class="related-section">
    <h2 class="related-title">Hoàn thiện phong cách</h2>
    <div class="related-grid">
        <c:forEach var="p" items="${complementaryProducts}">
            <a href="${pageContext.request.contextPath}/products/details.htm?id=${p.id}"
               class="related-card">
                <div class="related-img-wrapper">
                    <img src="${pageContext.request.contextPath}/images/products/${p.avatarName}"
                         alt="${p.productName}">
                </div>
                <div class="related-info">
                    <span class="related-price">$${p.price}</span>
                    <p class="related-name">${p.productName}</p>
                    <span class="related-color">Màu sắc</span>
                </div>
            </a>
        </c:forEach>
    </div>
</div>

<%-- BẠN CÓ THỂ SẼ THÍCH --%>
<div class="related-section">
    <h2 class="related-title">Bạn có thể sẽ thích</h2>
    <div class="related-grid">
        <c:forEach var="p" items="${relatedProducts}">
            <a href="${pageContext.request.contextPath}/products/details.htm?id=${p.id}"
               class="related-card">
                <div class="related-img-wrapper">
                    <button class="wishlist-mini">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                        </svg>
                    </button>
                    <img src="${pageContext.request.contextPath}/images/products/${p.avatarName}"
                         alt="${p.productName}">
                </div>
                <div class="related-info">
                    <span class="related-price">$${p.price}</span>
                    <p class="related-name">${p.productName}</p>
                    <span class="related-color">Màu sắc</span>
                </div>
            </a>
        </c:forEach>
    </div>
</div>

</body>
</html>
